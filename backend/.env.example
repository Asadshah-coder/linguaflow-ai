# LinguaFlow AI backend configuration — copy to .env and fill in.
# NEVER commit a real .env.

# Long random string. Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# 7 days default
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# SQLite for local dev. Production Postgres example:
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/linguaflow
DATABASE_URL=sqlite:///./linguaflow.db

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
