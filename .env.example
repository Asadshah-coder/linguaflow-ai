# LinguaFlow AI — environment configuration
# Copy to .env and fill in. All values are optional; the app works with zero config.

# Default translation provider: "mymemory" (default) or "libretranslate"
VITE_DEFAULT_PROVIDER=mymemory

# MyMemory: any email address acts as a free API key and raises the daily
# quota from 50k to 500k characters. Get one free at https://mymemory.translated.net
VITE_MYMEMORY_EMAIL=

# LibreTranslate: URL of your server (only used when provider is libretranslate)
# Example: VITE_LIBRETRANSLATE_URL=https://translate.example.com
VITE_LIBRETRANSLATE_URL=

# LibreTranslate API key (only if your server requires one)
VITE_LIBRETRANSLATE_API_KEY=
